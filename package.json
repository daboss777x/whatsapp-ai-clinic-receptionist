    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@trigger.dev/build": "^4.8.8",
    "@types/node": "^26.6.6",
    "supabase": "^3.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
