{
  "name": "whatsapp-ai-clinic-receptionist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx trigger.dev@latest dev",
    "deploy": "npx trigger.dev@latest deploy",
    "test:emma": "tsx --env-file=.env scripts/test-emma.ts",
    "typecheck": "tsc -p .",
    "simulate": "tsx --env-file=.env scripts/simulate-chat.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
