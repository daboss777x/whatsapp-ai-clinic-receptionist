# ============================================================
# Sunrise Clinic WhatsApp agent: every key this project needs
# Copy this file to .env and fill in the values. NEVER share .env.
# ============================================================

# --- WhatsApp Cloud API (Meta for Developers → your app → WhatsApp) ---
# Password that lets the agent send WhatsApp messages. Use a PERMANENT token: Business Settings → System Users → Generate token (permission: whatsapp_business_messaging)
WHATSAPP_ACCESS_TOKEN=
# ID of the clinic's WhatsApp number (not the phone number itself): WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
# A password YOU make up (any random phrase). You paste the same phrase into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Lets the webhook check that messages really come from Meta: App settings → Basic → App secret
META_APP_SECRET=

# --- Supabase (supabase.com → your project → Project Settings → API) ---
# Your project's web address, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Master key the agent uses to read/write the conversations table (the "service_role" secret key)
SUPABASE_SERVICE_ROLE_KEY=
# Short ID of your project: the "abcd1234" part of SUPABASE_URL
SUPABASE_PROJECT_REF=
# Lets Claude deploy the webhook + create the table for you: supabase.com/dashboard/account/tokens → Generate new token
SUPABASE_ACCESS_TOKEN=

# --- Trigger.dev (dashboard → your project → API Keys) ---
# Lets the edge function start the agent. DEV key (tr_dev_...) while building, swap to PROD key (tr_prod_...) at go-live
TRIGGER_SECRET_KEY=
# PRODUCTION secret key (tr_prod_...): Trigger.dev → API Keys → switch to Production. Claude swaps it into Supabase at go-live
TRIGGER_PROD_SECRET_KEY=

# --- OpenAI (platform.openai.com → API keys) ---
# Unlocks (and pays for) the AI brain
OPENAI_API_KEY=
# Which OpenAI model Emma uses
OPENAI_MODEL=gpt-6-luna

# --- Airtable (airtable.com/create/tokens) ---
# Personal access token, scopes: data.records:read + data.records:write, access to your clinic base
AIRTABLE_API_KEY=
# ID of your Airtable base, starts with "app…" (it's in the base's web address)
AIRTABLE_BASE_ID=
# Name of the table bookings are saved to
AIRTABLE_TABLE_NAME=Bookings
